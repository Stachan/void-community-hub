<h1>This is the show page for <%= @roster.name %></h1>
<% @units.each do |unit| %>
  <div class="card">
    <div class="container" id="unit-card-header">
      <div class="row">
        <!-- <div class="col-3" id="unit-portrait"></div> -->
        <div class="col-4" id="cal-selector">
          <div>CAL</div>
          <label for="lowest-cal" class="form-check-label d-flex justify-content-end">
            <input type="radio" class="form-check-input" id="lowest-cal" name="calibre">
            <div class="form-check">1</div>
          </label>
          <label for="mid-cal" class="form-check-label d-flex justify-content-end">
            <input type="radio" class="form-check-input" id="mid-cal" name="calibre">
            <div class="form-check">2</div>
          </label>
          <label for="highest-cal" class="form-check-label d-flex justify-content-end">
            <input type="radio" class="form-check-input" id="highest-cal" name="calibre">
            <div class="form-check">3</div>
          </label>
        </div>
        <div class="col-8">
          <div class="row">
            <div class="col-8" id="unit-title-bar">
              <div><%= unit.name %></div>
              <div>Flavor Name</div>
            </div>
            <div class="col-4" id="unit-cost">
              <div>Cost</div>
              <div>###</div>
            </div>
          </div>
          <div class="row g-2">
            <div class="col">
              <div>AS</div>
              <div><%= unit.assault %></div>
            </div>
            <div class="col">
              <div>SH</div>
              <div><%= unit.shooting %></div>
            </div>
            <div class="col">
              <div>ST</div>
              <div><%= unit.strength %></div>
            </div>
            <div class="col">
              <div>T</div>
              <div><%= unit.toughness %></div>
            </div>
            <div class="col">
              <div>W</div>
              <div><%= unit.wound %></div>
            </div>
            <div class="col">
              <div>CD</div>
              <div><%= unit.command %></div>
            </div>
            <div class="col">
              <div>SZ</div>
              <div><%= unit.size %></div>
            </div>
            <div class="col">
              <div>MV</div>
              <div><%= unit.move %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
