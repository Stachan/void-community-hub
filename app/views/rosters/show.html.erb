<h1>This is the show page for <%= @roster.name %></h1>
<% @units.each do |unit| %>
  <div class="card">
    <div class="container" id="unit-card-header">
      <div class="row">
        <!-- <div class="col-3" id="unit-portrait"></div> -->
        <div class="col-4" id="cal-selector">
          <div>CAL</div>
          <% cal_array = [] %>
          <% cal_btn_limit = 3 %>
          <% unit.cal0_cost != -1 ? cal_array.push([0, unit.cal0_cost]) : nil %>
          <% unit.cal1_cost != -1 ? cal_array.push([1, unit.cal1_cost]) : nil %>
          <% unit.cal2_cost != -1 ? cal_array.push([2, unit.cal2_cost]) : nil %>
          <% unit.cal3_cost != -1 ? cal_array.push([3, unit.cal3_cost]) : nil %>
          <% cal_array.each do |cal| %>
            <label for="cal-btn-<%= cal[0] %>" class="form-check-label d-flex justify-content-end">
              <input type="radio" class="form-check-input" id="cal-btn-<%= cal[0] %>" name="<%= unit.name %>-calibre">
              <div class="form-check"><%= cal[0] %></div>
            </label>
            <% cal_btn_limit -= 1 %>
          <% end %>
          <% if cal_btn_limit > 0 %>
            <% cal_btn_limit.times do %>
              <div id="cal-btn-placeholder">N/A</div>
            <% end %>
          <% end %>
        </div>
        <div class="col-8">
          <div class="row">
            <div class="col-8" id="unit-title-bar">
              <div><%= unit.name %></div>
              <div>Flavor Name</div>
            </div>
            <div class="col-4" id="unit-cost">
              <div>Cost</div>
              <div>###</div>
            </div>
          </div>
          <div class="row g-2">
            <div class="col">
              <div>AS</div>
              <div><%= unit.assault %></div>
            </div>
            <div class="col">
              <div>SH</div>
              <div><%= unit.shooting %></div>
            </div>
            <div class="col">
              <div>ST</div>
              <div><%= unit.strength %></div>
            </div>
            <div class="col">
              <div>T</div>
              <div><%= unit.toughness %></div>
            </div>
            <div class="col">
              <div>W</div>
              <div><%= unit.wound %></div>
            </div>
            <div class="col">
              <div>CD</div>
              <div><%= unit.command %></div>
            </div>
            <div class="col">
              <div>SZ</div>
              <div><%= unit.size %></div>
            </div>
            <div class="col">
              <div>MV</div>
              <div><%= unit.move %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
